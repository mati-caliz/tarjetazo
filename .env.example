# Casilla de Gmail donde caen los resúmenes de BNA (se leen por IMAP).
# EMAIL_USER = la dirección de Gmail
# EMAIL_APP_PASSWORD = app password de Gmail (requiere verificación en 2 pasos activada)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Opcional: host IMAP. Por defecto imap.gmail.com.
# IMAP_HOST=imap.gmail.com

# Clave del PDF del resumen BNA (tu DNI)
PDF_PASSWORD=

# Respondi entrega el mensaje por el bot de Tarjetazo. La API key debe tener
# únicamente el scope "send".
RESPONDI_API_URL=https://monia.lantix.com.ar
RESPONDI_API_KEY=
RESPONDI_CHANNEL_ID=
TELEGRAM_CHAT_ID=

# Opcionales: DeepSeek es el proveedor principal y Gemini el respaldo.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.6-flash
